# =============================================================================
# 🔒 SERVER-ONLY (PRIVATE) - Never expose to client
# =============================================================================
# These keys are server-only and should NEVER be prefixed with NEXT_PUBLIC_

# Gemini API Key (server-only)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenRouter API Key (server-only, optional - used as primary AI provider with Gemini fallback)
OPENROUTER_API_KEY=

# Openai
OPENAI_API_KEY=

# Deepseek
DEEPSEEK_API_KEY=

# Firebase Service Account (server-only - for migrations/admin)
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Supabase Service Role Key (server-only - for admin operations)
SUPABASE_SERVICE_ROLE_KEY=

# =============================================================================
# 🌐 PUBLIC (NEXT_PUBLIC_*) - Safe to expose to client
# =============================================================================
# These variables are designed to be public and work in both server and client

# Backend Provider
# Values: firebase | supabase | mock
NEXT_PUBLIC_BACKEND_PROVIDER=firebase

# Error tracking provider (server + client). Values: sentry | none
NEXT_PUBLIC_ERROR_TRACKING_PROVIDER=sentry

# Analytics provider. Values: ga4 | none
NEXT_PUBLIC_ANALYTICS_PROVIDER=ga4

# =============================================================================
# 🔍 Sentry (error tracking - optional)
# =============================================================================
# DSN is a public URL (safe to expose). Set the same value on both vars below.
# Without a DSN the app runs normally and telemetry stays in no-op mode.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=

# Used only at build time to upload source maps. Optional - skip source maps if unset.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Payment Provider
# Values: abacatepay | stripe | mock
NEXT_PUBLIC_PAYMENT_PROVIDER=abacatepay

# Stripe
STRIPE_SECRET_KEY=

# Gemini Models (public defaults)
NEXT_PUBLIC_GEMINI_FAST_DEFAULT_MODEL=gemini-3-flash-preview
NEXT_PUBLIC_GEMINI_PRO_DEFAULT_MODEL=gemini-3-pro-preview

# Firebase Configuration (public - safe to expose)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Supabase Configuration (public - safe to expose)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional: Override base URL for auth redirects (e.g. http://localhost:3000)
# If not set, falls back to window.location.origin dynamically
NEXT_PUBLIC_APP_URL=

# Donation Information (public)
NEXT_PUBLIC_PIX_KEY=
NEXT_PUBLIC_BTC_ADDRESS=
NEXT_PUBLIC_USDC_ADDRESS=
NEXT_PUBLIC_APP_VERSION=