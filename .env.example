# Gemini API Key for AI services
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_FAST_DEFAULT_MODEL=gemini-3-flash-preview
GEMINI_PRO_DEFAULT_MODEL=gemini-3-pro-preview

# Backend Provider (client-side)
# Values: firebase | supabase | mock
NEXT_PUBLIC_BACKEND_PROVIDER=firebase

# Gemini Models (Public - client-side)
NEXT_PUBLIC_GEMINI_FAST_DEFAULT_MODEL=gemini-3-flash-preview
NEXT_PUBLIC_GEMINI_PRO_DEFAULT_MODEL=gemini-3-pro-preview

# Firebase Configuration (Public - client-side)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Supabase Configuration (Public - client-side)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Migration & Admin Credentials (Firebase -> Supabase)
# Firebase Service Account (Required for migration script)
# Get these from: Firebase Console -> Settings -> Service Accounts -> Generate new private key
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Supabase Service Role Key (Required for migration script and server-side auth)
# Get from: Supabase Dashboard -> Settings -> API
SUPABASE_SERVICE_ROLE_KEY=

# Donation Information (Public - available on client side)
NEXT_PUBLIC_PIX_KEY=
NEXT_PUBLIC_BTC_ADDRESS=
NEXT_PUBLIC_USDC_ADDRESS=